<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
  <com.google.android.material.card.MaterialCardView
      style="@style/Plees.Card"
      android:id="@+id/fragment_stats_sleeps_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="10dp"
      app:cardBackgroundColor="?attr/colorPrimaryContainer">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
      <TextView
          android:id="@+id/fragment_stats_sleeps"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/Plees.Title"
          android:textColor="?attr/colorOnPrimaryContainer"/>
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/sleeps"
          android:textAppearance="?attr/textAppearanceTitleMedium"
          android:textColor="?attr/colorOnPrimaryContainer"/>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView
      style="@style/Plees.Card"
      android:id="@+id/fragment_stats_average_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="10dp"
      app:cardBackgroundColor="?attr/colorSecondaryContainer">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
      <TextView
          android:id="@+id/fragment_stats_average"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/Plees.Title"
          android:textColor="?attr/colorOnSecondaryContainer"/>
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/average_string"
          android:textAppearance="?attr/textAppearanceTitleMedium"
          android:textColor="?attr/colorOnSecondaryContainer"/>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView
      style="@style/Plees.Card"
      android:id="@+id/fragment_stats_daily_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="10dp"
      app:cardBackgroundColor="?attr/colorTertiaryContainer">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
      <TextView
          android:id="@+id/fragment_stats_daily"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textAppearance="@style/Plees.Title"
          android:textColor="?attr/colorOnTertiaryContainer"/>
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="@string/daily_average_string"
          android:textAppearance="?attr/textAppearanceTitleMedium"
          android:textColor="?attr/colorOnTertiaryContainer"/>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>
