<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sleep_details"
        android:textAppearance="@style/Plees.Title"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_hint"
        android:layout_marginVertical="16dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"/>
    <hu.vmiklos.plees_tracker.StageSummaryView
        android:id="@+id/sleep_stages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.google.android.material.card.MaterialCardView
        style="@style/Plees.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/started_on"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textAppearance="?attr/textAppearanceLabelLarge"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sleep_start_date"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sleep_start_time"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        style="@style/Plees.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stopped_on"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textAppearance="?attr/textAppearanceLabelLarge"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sleep_stop_date"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sleep_stop_time"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/times_woken_up">
      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/sleep_item_wakes"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rest_rating"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:layout_marginTop="24dp"/>
    <RatingBar
        android:id="@+id/sleep_item_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1"/>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sleep_notes"
        android:layout_marginTop="24dp">
      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/sleep_item_comment"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minLines="4"
          android:gravity="top"
          android:inputType="textMultiLine|textCapSentences"/>
    </com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
